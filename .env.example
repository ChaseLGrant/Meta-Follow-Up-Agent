# Copy these into Netlify → Site configuration → Environment variables (never commit real values).

# This follow-up site's public URL (no trailing slash)
PUBLIC_BASE_URL=https://follow-up.theathletemarket.com

# Supabase Postgres connection string (use the "Transaction pooler" URI, port 6543)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# SAFETY SWITCH: dry_run (no texts) -> test (only SMS_TEST_ALLOWLIST) -> live (only after approval)
SMS_MODE=dry_run
SMS_TEST_ALLOWLIST=+17605551234

# Twilio (Console → Account info; Messaging → Services)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Calendly
CALENDLY_URL=https://calendly.com/your-name/recruiting-call
CALENDLY_WEBHOOK_SIGNING_KEY=generate-a-long-random-string
TRACK_LINK_CLICKS=true

# Lead sources
NETLIFY_WEBHOOK_SECRET=generate-a-long-random-string
LEAD_INTAKE_TOKEN=generate-a-long-random-string

# Alerts to you
OWNER_PHONE=+17605551234
OWNER_EMAIL=chase@theathletemarket.com
RESEND_API_KEY=re_xxxxxxxx
ALERT_FROM_EMAIL=alerts@theathletemarket.com
OWNER_TIMEZONE=America/Los_Angeles

DASHBOARD_PASSWORD=generate-a-long-random-string

# Optional tuning (defaults shown)
# SEND_WINDOW_START_HOUR=8
# SEND_WINDOW_END_HOUR=20
# FOLLOW_UP_1_HOURS=24
# FOLLOW_UP_2_HOURS=72
# MAX_SMS_PER_HOUR=60
# LEAD_SILENCE_ALERT_HOURS=48
# FAILURE_ALERT_THRESHOLD=3
